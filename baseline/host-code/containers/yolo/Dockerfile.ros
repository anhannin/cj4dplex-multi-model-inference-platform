FROM cj-yolo:26l-cu130 AS ros-deps
COPY containers/ros2/install_ros.sh /tmp/install_ros.sh
RUN bash /tmp/install_ros.sh && rm /tmp/install_ros.sh
# Ultralytics probes HEIF on unidentified images; install its stock optional codec at build time.
RUN python -m pip install --no-cache-dir pi-heif==1.4.0
RUN bash -c 'source /opt/ros/jazzy/setup.bash && python -c "import rclpy; from sensor_msgs.msg import CompressedImage; print(CompressedImage())"' && python -m pip check
FROM ros-deps AS runtime
COPY ros2/yolo_node.py /app/ros2/yolo_node.py
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && exec python /app/ros2/yolo_node.py \"$@\"", "--"]
