[Unit]
Description=CJ same-user CUDA MPS for independent Qwen and YOLO Pods

[Service]
Type=simple
Environment=CUDA_MPS_PIPE_DIRECTORY=/home/avees/cj-serving/mps-green-v1/mps-pipe
Environment=CUDA_MPS_LOG_DIRECTORY=/home/avees/cj-serving/mps-green-v1/mps-log
ExecStart=/usr/bin/nvidia-cuda-mps-control -f
ExecStop=/bin/bash -c 'printf "quit\n" | /usr/bin/nvidia-cuda-mps-control'
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
