{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "qwen",
    "namespace": "cj-inference"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "qwen"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "qwen"
        }
      },
      "spec": {
        "runtimeClassName": "nvidia",
        "nodeSelector": {
          "kubernetes.io/hostname": "spark-e6d6"
        },
        "hostNetwork": true,
        "hostIPC": true,
        "dnsPolicy": "ClusterFirstWithHostNet",
        "automountServiceAccountToken": false,
        "terminationGracePeriodSeconds": 300,
        "securityContext": {
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000
        },
        "containers": [
          {
            "name": "qwen",
            "image": "docker.io/library/cj-qwen-ros:9b-timing-v1",
            "imagePullPolicy": "Never",
            "env": [
              {
                "name": "HOME",
                "value": "/runtime"
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "4"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRITON_CACHE_DIR",
                "value": "/runtime/triton"
              },
              {
                "name": "YOLO_CONFIG_DIR",
                "value": "/runtime/ultralytics"
              },
              {
                "name": "ROS_DOMAIN_ID",
                "value": "42"
              },
              {
                "name": "ROS_AUTOMATIC_DISCOVERY_RANGE",
                "value": "LOCALHOST"
              },
              {
                "name": "RMW_IMPLEMENTATION",
                "value": "rmw_fastrtps_cpp"
              },
              {
                "name": "NVIDIA_DRIVER_CAPABILITIES",
                "value": "compute,utility"
              },
              {
                "name": "GREEN_ENABLED",
                "value": "1"
              },
              {
                "name": "GREEN_PARTITION_INDEX",
                "value": "1"
              },
              {
                "name": "GREEN_LEFT_SMS",
                "value": "32"
              },
              {
                "name": "GREEN_EXPECTED_SM",
                "value": "16"
              },
              {
                "name": "PAIR_LABEL",
                "value": "serving-mps-green"
              },
              {
                "name": "PYTHONPATH",
                "value": "/experiment/src"
              },
              {
                "name": "CUDA_MPS_PIPE_DIRECTORY",
                "value": "/home/avees/cj-serving/mps-green-v1/mps-pipe"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "24Gi",
                "nvidia.com/gpu.shared": 1
              },
              "limits": {
                "nvidia.com/gpu.shared": 1
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "runtime",
                "mountPath": "/runtime"
              },
              {
                "name": "cache",
                "mountPath": "/cache",
                "readOnly": true
              },
              {
                "name": "green-experiment",
                "mountPath": "/experiment"
              },
              {
                "name": "mps-pipe",
                "mountPath": "/home/avees/cj-serving/mps-green-v1/mps-pipe"
              }
            ],
            "startupProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "test -s /tmp/cj-model-ready && kill -0 \"$(cat /tmp/cj-model-ready)\""
                ]
              },
              "periodSeconds": 5,
              "timeoutSeconds": 2,
              "failureThreshold": 120
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "test -s /tmp/cj-model-ready && kill -0 \"$(cat /tmp/cj-model-ready)\""
                ]
              },
              "periodSeconds": 5,
              "timeoutSeconds": 2,
              "failureThreshold": 3
            },
            "args": [],
            "command": [
              "/bin/bash",
              "-c",
              "set -eo pipefail; test -S \"$CUDA_MPS_PIPE_DIRECTORY/control\"; printf \"get_server_list\\n\" | nvidia-cuda-mps-control >/dev/null; source /opt/ros/jazzy/setup.bash && exec python /experiment/src/qwen_green_node.py"
            ]
          }
        ],
        "volumes": [
          {
            "name": "runtime",
            "emptyDir": {}
          },
          {
            "name": "cache",
            "hostPath": {
              "path": "/home/avees/.cache/huggingface/hub",
              "type": "Directory"
            }
          },
          {
            "name": "green-experiment",
            "hostPath": {
              "path": "/home/avees/cj-serving/mps-green-v1",
              "type": "Directory"
            }
          },
          {
            "name": "mps-pipe",
            "hostPath": {
              "path": "/home/avees/cj-serving/mps-green-v1/mps-pipe",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}