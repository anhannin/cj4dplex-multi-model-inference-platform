{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "annotations": {
      "deployment.kubernetes.io/revision": "2"
    },
    "name": "qwen",
    "namespace": "cj-inference"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "qwen"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "qwen"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "env": [
              {
                "name": "HOME",
                "value": "/runtime"
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "4"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRITON_CACHE_DIR",
                "value": "/runtime/triton"
              },
              {
                "name": "YOLO_CONFIG_DIR",
                "value": "/runtime/ultralytics"
              },
              {
                "name": "ROS_DOMAIN_ID",
                "value": "42"
              },
              {
                "name": "ROS_AUTOMATIC_DISCOVERY_RANGE",
                "value": "LOCALHOST"
              },
              {
                "name": "RMW_IMPLEMENTATION",
                "value": "rmw_fastrtps_cpp"
              },
              {
                "name": "NVIDIA_DRIVER_CAPABILITIES",
                "value": "compute,utility"
              }
            ],
            "image": "docker.io/library/cj-qwen-ros:9b-timing-v1",
            "imagePullPolicy": "Never",
            "name": "qwen",
            "readinessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "test -s /tmp/cj-model-ready && kill -0 \"$(cat /tmp/cj-model-ready)\""
                ]
              },
              "failureThreshold": 3,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 2
            },
            "resources": {
              "limits": {
                "nvidia.com/gpu.shared": "1"
              },
              "requests": {
                "cpu": "1",
                "memory": "24Gi",
                "nvidia.com/gpu.shared": "1"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "startupProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "test -s /tmp/cj-model-ready && kill -0 \"$(cat /tmp/cj-model-ready)\""
                ]
              },
              "failureThreshold": 120,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 2
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/runtime",
                "name": "runtime"
              },
              {
                "mountPath": "/cache",
                "name": "cache",
                "readOnly": true
              },
              {
                "name": "nsight-diagnostics",
                "mountPath": "/diagnostics",
                "readOnly": true
              },
              {
                "name": "nsight-reports",
                "mountPath": "/profiles"
              }
            ],
            "command": [
              "/bin/bash",
              "/diagnostics/launch_node.sh",
              "qwen"
            ],
            "args": []
          }
        ],
        "dnsPolicy": "ClusterFirstWithHostNet",
        "hostIPC": true,
        "hostNetwork": true,
        "nodeSelector": {
          "kubernetes.io/hostname": "spark-e6d6"
        },
        "restartPolicy": "Always",
        "runtimeClassName": "nvidia",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsUser": 1000
        },
        "terminationGracePeriodSeconds": 300,
        "volumes": [
          {
            "emptyDir": {},
            "name": "runtime"
          },
          {
            "hostPath": {
              "path": "/home/avees/.cache/huggingface/hub",
              "type": "Directory"
            },
            "name": "cache"
          },
          {
            "name": "nsight-diagnostics",
            "configMap": {
              "name": "cj-nsys-diagnostics"
            }
          },
          {
            "name": "nsight-reports",
            "hostPath": {
              "path": "/home/avees/cj-nsys-diagnostics/20261103-v1/reports",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}